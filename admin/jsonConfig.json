{
    "i18n": true,
    "type": "panel",
    "items": {
        "ipAddress": {
            "type": "text",
            "label": "IP address of the SMA eCharger",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4
        },
        "pollInterval": {
            "type": "number",
            "label": "Polling interval (seconds)",
            "min": 15,
            "max": 3600,
            "default": 15,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4
        },
        "username": {
            "type": "text",
            "label": "Username (default: user)",
            "default": "user",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4
        },
        "password": {
            "type": "password",
            "label": "Password",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4
        },
        "expertMode": {
            "type": "checkbox",
            "label": "Expert mode (create all Parameter.* states)",
            "default": false,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 8,
            "lg": 6,
            "xl": 6
        },
        "carConsumption": {
            "type": "number",
            "label": "Vehicle consumption (kWh/100 km)",
            "min": 0,
            "max": 100,
            "default": 18,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "cleanUp": {
            "type": "sendTo",
            "command": "cleanupOrphans",
            "label": "Clean up orphaned states",
            "variant": "outlined",
            "icon": "delete",
            "showProcess": true,
            "newLine": true,
            "confirm": {
                "title": "Really delete orphaned states?",
                "text": "All currently unused Parameter and Control states (without active History/InfluxDB logging) will be permanently deleted.",
                "ok": "Delete",
                "cancel": "Cancel"
            },
            "xs": 12,
            "sm": 8,
            "md": 8,
            "lg": 6,
            "xl": 6
        }
    }
}
