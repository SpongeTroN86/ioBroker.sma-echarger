{
    "i18n": true,
    "type": "panel",
    "items": {
        "ipAddress": {
            "type": "text",
            "label": "IP-Adresse des SMA eChargers",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4
        },
        "pollInterval": {
            "type": "number",
            "label": "Abfrageintervall (Sekunden)",
            "min": 15,
            "max": 3600,
            "default": 15,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4
        },
        "username": {
            "type": "text",
            "label": "Benutzername (Standard: Benutzer)",
            "default": "user",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4
        },
        "password": {
            "type": "password",
            "label": "Passwort",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4
        },
        "expertMode": {
            "type": "checkbox",
            "label": "Expertenmodus (alle Parameter.*-Datenpunkte anlegen)",
            "default": false,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 8,
            "lg": 6,
            "xl": 6
        },
        "carConsumption": {
            "type": "number",
            "label": "Fahrzeugverbrauch (kWh/100 km)",
            "min": 0,
            "max": 100,
            "default": 18,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        }
    }
}
